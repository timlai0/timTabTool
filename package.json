{
  "name": "timtabtool",
  "private": true,
  "version": "1.2.0.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "vite build --config vite.config.firefox.ts && vite build --config vite.config.firefox.content.ts",
    "build:firefox:sign": "npm run build:firefox && npm run sign:firefox",
    "watch:firefox": "vite build --config vite.config.firefox.ts --watch",
    "prebuild": "node scripts/bump-version.js",
    "build:all": "npm run build && npm run build:firefox",
    "sign:firefox": "dotenv -- web-ext sign --source-dir dist-firefox --channel unlisted --artifacts-dir web-ext-artifacts",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timlai0/timTabTool.git"
  },
  "homepage": "https://github.com/timlai0/timTabTool#readme",
  "bugs": {
    "url": "https://github.com/timlai0/timTabTool/issues"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "browser-extension",
    "tab-manager",
    "tab-groups",
    "tab-organizer",
    "ai",
    "timtabtool"
  ],
  "author": "Tim Lai <mail@timlai.de> (original TabPilot by Florian)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/chrome": "^0.1.37",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.27",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.5.0"
  }
}

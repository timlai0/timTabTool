{
  "name": "timtabtool",
  "version": "1.1.3",
  "description": "Smart tab organization, MCP bridge, AI grouping — the ultimate browser tool.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "vite build --config vite.config.firefox.ts && vite build --config vite.config.firefox.content.ts && npm run sign:firefox",
    "watch:firefox": "vite build --config vite.config.firefox.ts --watch",
    "build:all": "npm run build && npm run build:firefox",
    "sign:firefox": "dotenv -- web-ext sign --source-dir dist-firefox --channel unlisted",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "tab-manager",
    "tab-groups",
    "tab-organizer",
    "ai",
    "timtabtool"
  ],
  "author": "Florian",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/chrome": "^0.1.37",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.27",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.5.0"
  }
}
